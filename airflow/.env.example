# Copy to airflow/.env (gitignored) before `docker compose up`. See docs/AIRFLOW.md.

# Your host user ID, so files written to mounted directories belong to you: `id -u`.
AIRFLOW_UID=501

# Source CRM dataset the pipeline extracts from (read-only), reached from the containers
# through the host. Must be the synthetic dataset described by data/raw's manifest.
SYNTHETIC_DATABASE_URL=postgresql+psycopg://revintel:revintel@host.docker.internal:5432/revintel_ml

# MLflow tracking server on the host. Start it so containers can reach it:
#   MLFLOW_HOST=0.0.0.0 \
#   MLFLOW_SERVER_ALLOWED_HOSTS="localhost:*,127.0.0.1:*,host.docker.internal:*" \
#   scripts/start_mlflow.sh
MLFLOW_TRACKING_URI=http://host.docker.internal:5001
MLFLOW_MODEL_NAME=revintel-lead-conversion

# Optional: set real values for anything beyond local development.
# FERNET_KEY=
# AIRFLOW__API_AUTH__JWT_SECRET=
