APP_NAME=RevIntel
# local = human-readable logs; test/staging/production = JSON logs.
ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://revintel:revintel@localhost:5432/revintel
TEST_DATABASE_URL=postgresql+psycopg://revintel:revintel@localhost:5432/revintel_test
# Synthetic CRM data target (scripts/generate_crm_data.py) is read from the shell
# environment only (not from .env), and must end in _ml or _test. DATABASE_URL is never used:
#   export SYNTHETIC_DATABASE_URL=postgresql+psycopg://revintel:revintel@localhost:5432/revintel_ml

REDIS_URL=redis://localhost:6379/0
# Account read cache (seconds); 0 disables caching.
ACCOUNT_CACHE_TTL_SECONDS=300
CACHE_REDIS_TIMEOUT_SECONDS=0.2

# Required, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME
# Fixed to HS256 in V1.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_MODEL_NAME=revintel-lead-conversion

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

LLM_PROVIDER=mock

AWS_REGION=us-east-1